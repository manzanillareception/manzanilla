# Copy outside the repository to an owner-only regular file (chmod 600).
# Single-quote values containing $, #, spaces or other dotenv-special text.
# Use production validation for staging too; give staging its own project/secrets.
MANZ_ENVIRONMENT=production
MANZ_DOMAIN=REPLACE_WITH_OWNED_HOSTNAME
MANZ_PUBLIC_ORIGIN=https://REPLACE_WITH_OWNED_HOSTNAME
MANZ_DATABASE_URL=REPLACE_WITH_POSTGRESQL_PSYCOPG_CONNECTION
MANZ_SUPABASE_URL=https://REPLACE_WITH_PROJECT.supabase.co
MANZ_SUPABASE_PUBLISHABLE_KEY=REPLACE_OUT_OF_BAND
MANZ_SUPABASE_SECRET_KEY=REPLACE_OUT_OF_BAND
MANZ_SESSION_ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY_OUT_OF_BAND
MANZ_SESSION_TTL_SECONDS=3600
MANZ_COOKIE_SECURE=true
# Optional, only for first-owner bootstrap: trusted existing Supabase subject UUID.
# This is not an email allowlist and it does not create or email an account.
MANZ_BOOTSTRAP_OWNER_SUB=
